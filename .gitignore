# Editor / OS files
.DS_Store
Thumbs.db
.vscode/

# Server credentials must never be committed
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json

# Android downloads and private signing keys
APK/*.apk
APK/android/app/src/local/assets/
APK/android/app/src/firebase/assets/
*.jks
*.keystore
