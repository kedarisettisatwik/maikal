# Dependencies and build output
node_modules/
dist/
coverage/
*.log

# Local configuration; only the blank example is committed
.env
.env.*
!.env.example
.publish/

# Duplicate originals; the app serves public/ assets
/expenses/
/iconsGoal/
/icons/
/logo.png
/favicon.ico
