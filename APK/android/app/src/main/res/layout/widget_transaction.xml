<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_paper" android:padding="14dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/maikal_logo" android:contentDescription="@string/app_name" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_money_name" android:textColor="#253439" android:textSize="18sp" android:fontFamily="serif" android:textStyle="bold" android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/widget_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:background="@drawable/widget_expense_button" android:text="@string/widget_expense" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/widget_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:background="@drawable/widget_income_button" android:text="@string/widget_income" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
