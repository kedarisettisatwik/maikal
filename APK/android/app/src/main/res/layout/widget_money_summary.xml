<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_money_summary" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_paper" android:padding="14dp" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_summary_name" android:fontFamily="serif" android:textSize="20sp" android:textStyle="bold" android:textColor="#253439" />
    <TextView android:id="@+id/widget_money_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#66716A" android:layout_marginBottom="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_day_expense" android:textSize="12sp" android:textColor="#66716A" />
            <TextView android:id="@+id/widget_day_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="#E33D3D" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="19sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_month_expense" android:textSize="12sp" android:textColor="#66716A" />
            <TextView android:id="@+id/widget_month_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="#E33D3D" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="19sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_month_income" android:textSize="12sp" android:textColor="#66716A" />
            <TextView android:id="@+id/widget_month_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="#008B47" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="19sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_month_saving" android:textSize="12sp" android:textColor="#66716A" />
            <TextView android:id="@+id/widget_month_saving" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="#285D79" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="19sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
