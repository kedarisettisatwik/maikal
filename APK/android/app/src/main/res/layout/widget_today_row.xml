    <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#253439" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
    <TextView android:id="@+id/widget_row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#66716A" android:textSize="12sp" android:layout_marginTop="3dp" />
</LinearLayout>
